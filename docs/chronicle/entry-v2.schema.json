{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle-entries-v2",
  "title": "fnaf2-1020 chronicle checkpoint, v2",
  "description": "A checkpoint of chronicle-entry-v2 entries. Documentation only: tools/chronicle-schema.mjs enforces this and the cross-entry rules no schema expresses (unique ids and checkpoints, dates inside the checkpoint's month, supersedes and supersededBy resolving and agreeing, one correction per entry).",
  "type": "object",
  "required": ["schema", "checkpoint", "label", "entries"],
  "properties": {
    "schema": {"const": "chronicle-entries-v2"},
    "checkpoint": {"type": "string", "pattern": "^\\d{4}-\\d{2}[b-z]?$"},
    "label": {"type": "string", "minLength": 1},
    "outlook": {"$ref": "#/$defs/outlook"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "outlook": {
      "type": "object",
      "required": ["next", "missing"],
      "properties": {
        "next": {"type": "array", "items": {"$ref": "#/$defs/outlookItem"}},
        "missing": {"type": "array", "items": {"$ref": "#/$defs/outlookItem"}}
      },
      "additionalProperties": false
    },
    "outlookItem": {
      "type": "object",
      "required": ["title", "body", "sources"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "entry": {
      "title": "chronicle-entry-v2",
      "type": "object",
      "required": ["id", "date", "game", "kind", "title", "body", "measured", "label", "rung", "plan", "night", "route", "tags", "sources", "status", "supersededBy", "supersedes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "date": {"type": "string", "format": "date"},
        "game": {"enum": ["fnaf1", "fnaf2", "fnaf3", "fnaf4"]},
        "kind": {"enum": ["milestone", "lesson", "refutation", "retraction", "negative", "fact", "trivia"]},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "measured": {"type": ["string", "null"]},
        "label": {"enum": ["SOURCED", "CALIBRATED", "DEVICE_MEASURED", "INFERRED", "MODEL", "UNKNOWN", "MODEL_ONLY", "FIXTURE"]},
        "rung": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
        "plan": {"type": ["integer", "null"], "minimum": 1},
        "night": {"type": ["integer", "null"], "minimum": 1, "maximum": 8},
        "route": {"type": ["string", "null"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["standing", "superseded", "retracted"]},
        "supersededBy": {"type": ["string", "null"]},
        "supersedes": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
      },
      "allOf": [
        {"if": {"properties": {"game": {"enum": ["fnaf1", "fnaf2"]}}}, "then": {"properties": {"night": {"maximum": 7}}}},
        {"if": {"properties": {"game": {"const": "fnaf3"}}}, "then": {"properties": {"night": {"maximum": 6}}}},
        {"if": {"properties": {"game": {"not": {"const": "fnaf2"}}}}, "then": {"properties": {"route": {"const": null}, "rung": {"const": null}}}}
      ]
    }
  }
}
