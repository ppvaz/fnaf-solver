 "findings": [
  "All 291 slot reads over the 97 retained FNaF 1 title frames are exactly 0.0 or 1.0, and every frame fills its slots left to right: the core box separates a star from the static behind the title with no intermediate value.",
  "The save reads 0 stars on 2026-09-22, 2 from 2026-09-24 through the 4/20 night 420-a's title before it, and 3 on 420-a's title after it and on every later run (b, c, d).",
  "Frames named title-* that read 0 stars in runs b and d are not title reads: the runner's own title model did not read them confidently, and fnaf1-title-stars.py run counts only confident title frames."
 ],
 "limitations": [
  "One handset and one build (2.0.7+40), helper native frames at 2400x1080; another device needs its own slot geometry.",
  "The frames themselves are withheld under the publishing boundary; this record carries their sha256 and the reads only."
 ],
 "reproducer": "python3 packages/play/games/fnaf1/fnaf1-title-stars.py calibrate ~/fnaf-apks/fnaf1-device-runs/*/ --json <out>"
}
