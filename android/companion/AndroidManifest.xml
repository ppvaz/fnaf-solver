<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ppvaz.fnafcompanion">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <!-- Required by the loopback control server (127.0.0.1 only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AUDIO probe only: AudioPlaybackCapture of the projection, reduced on the
         phone to derived numbers (AudioProbe.java); no audio is stored or sent. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Explicitly enabled by the user for the teach panels (non-interactive overlay windows). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Every target the Companion may name (Targets.java,
         tools/device/models/companion-targets-v1.json), so it can read their
         installed build and launch intent. -->
    <queries>
        <package android:name="com.scottgames.fivenightsatfreddys" />
        <package android:name="com.scottgames.fnaf2" />
        <package android:name="com.scottgames.fnaf3" />
        <package android:name="com.scottgames.fnaf4" />
        <package android:name="org.fnaf1rebuild.play" />
        <package android:name="org.fnaf2rebuild.play" />
        <package android:name="org.fnaf3rebuild.play" />
        <package android:name="org.fnaf4rebuild.play" />
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:icon="@mipmap/companion_icon_adaptive"
        android:label="FNaF Companion"
        android:roundIcon="@mipmap/companion_icon_adaptive"
        android:supportsRtl="true"
        android:theme="@style/CompanionTheme">
        <activity
            android:name="com.ppvaz.fnafcompanion.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Explicitly launched only for the on-device actuator benchmark. -->
        <activity
            android:name="com.ppvaz.fnafcompanion.AccessibilityProbeActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!-- Debug-only shell command bridge; it must not create a game-replacing window. -->
        <receiver
            android:name="com.ppvaz.fnafcompanion.AccessibilityGameProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name="com.ppvaz.fnafcompanion.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />

        <!-- User/shell-enabled benchmark service; it has no production game policy. -->
        <service
            android:name="com.ppvaz.fnafcompanion.AccessibilityProbeService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_probe_service" />
        </service>

    </application>
</manifest>
