#!/bin/sh
# Validate the pushed commits the way CI will see them: in a clean checkout.
# The gate reads the ref lines git feeds this hook on stdin. Enable with
#   git config core.hooksPath .githooks
# A red lane is fixed and pushed again, never sent past this hook: CLAUDE.md
# forbids bypassing a hook, and the gate names each failed lane with the
# command that reproduces it.
#
# Before the gate, every pushed commit's author and committer address must be
# GitHub's noreply form (tools/commit-identity.ts): rebase and cherry-pick
# never run commit-msg. Both read the same ref lines.
refs=$(cat)
printf '%s\n' "$refs" | node "$(dirname "$0")/../tools/commit-identity.ts" --push || exit 1
printf '%s\n' "$refs" | node "$(dirname "$0")/../tools/push-gate.ts" --stdin
