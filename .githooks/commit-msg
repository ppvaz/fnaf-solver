#!/bin/sh
# Consequence lock (2026-09-06, loosened 2026-09-25 -- plans/ROADMAP.md). A
# commit that touches only bookkeeping paths (docs/, plans/, markdown, agent
# instructions) must arrive with a retained record: device evidence, a run
# pack, or a host-side step record (twin, trace equivalence, census with a
# named held-out block), staged under artifacts/ or docs/evidence/ in the same
# commit, or referenced from a prior commit with EVIDENCE:<path>.
# PEDRO-OK in the message is the human-only override. Agents never write
# the key and never bypass this hook (--no-verify, commit -n).
#
# Before that lock, every message is checked for copied dump text
# (tools/dump-text-check.mjs).

msgfile="$1"

# Decompiled dump text (ADR 0002, decision 12): a message may cite g###, a
# file and a line, and paraphrase, but never copy dump lines. This runs first
# and on every commit, even one with nothing staged, and PEDRO-OK below waives
# the consequence lock, not this.
if ! command -v node > /dev/null 2>&1; then
  echo "dump-text check: node is not on PATH, so the message cannot be checked." >&2
  exit 1
fi
node "$(dirname "$0")/../tools/dump-text-check.mjs" "$msgfile" || exit 1

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# Paired evidence staged in this commit?
if echo "$staged" | grep -Eq '^(artifacts/|docs/evidence/)'; then
  exit 0
fi

# Human override. Agents never write this key.
if grep -q 'PEDRO-OK' "$msgfile"; then
  echo "consequence lock: human override accepted." >&2
  exit 0
fi

# Reference to evidence from a prior commit?
ref=$(sed -n 's/.*EVIDENCE:\([^ ,)"'"'"']*\).*/\1/p' "$msgfile" | head -n 1)
if [ -n "$ref" ]; then
  if [ -e "$ref" ] || git cat-file -e "HEAD:$ref" 2>/dev/null; then
    exit 0
  fi
  echo "consequence lock: EVIDENCE ref not found: $ref" >&2
  exit 1
fi

# Refuse only when every staged path is bookkeeping.
if ! echo "$staged" | grep -Ev '^(docs/|plans/)|\.md$' > /dev/null; then
  echo "consequence lock: refused — bookkeeping-only commit without evidence." >&2
  echo "  - stage the evidence (artifacts/, docs/evidence/) in this commit," >&2
  echo "  - add EVIDENCE:<path> naming evidence from a prior commit, or" >&2
  echo "  - have Pedro add PEDRO-OK to the message." >&2
  exit 1
fi

exit 0
