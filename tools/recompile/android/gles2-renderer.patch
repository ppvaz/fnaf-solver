diff --git a/Chowdren/base/desktop/renderplatform.h b/Chowdren/base/desktop/renderplatform.h
index fd0af95..38d61d3 100644
--- a/Chowdren/base/desktop/renderplatform.h
+++ b/Chowdren/base/desktop/renderplatform.h
@@ -569,8 +569,24 @@ inline Texture Render::copy_rect(int x1, int y1, int x2, int y2)
 
     int y = WINDOW_HEIGHT - y2;
     set_tex(render_data.back_tex);
+#ifdef CHOWDREN_USE_GLES2
+    // GL ES 2.0 copies from the bound framebuffer (the RGBA8 screen FBO) into
+    // an RGB texture, a format ES allows from an RGBA source (ES 2.0 table
+    // 3.9), so the copy samples with alpha 1 as on desktop. The storage is
+    // specified only when the rectangle's size changes: re-specifying it
+    // every frame orphans the texture on tiled GPUs. glCopyTexSubImage2D
+    // overwrites the whole rectangle, so the contents are the same.
+    static int back_width = -1, back_height = -1;
+    if (width != back_width || height != back_height) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, width, height,
+                     0, GL_RGB, GL_UNSIGNED_BYTE, NULL);
+        back_width = width;
+        back_height = height;
+    }
+#else
     glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, width, height,
                  0, GL_RGB, GL_UNSIGNED_BYTE, NULL);
+#endif
     glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, x1, y, width, height);
     return render_data.back_tex;
 }
diff --git a/Chowdren/base/gles2shader.h b/Chowdren/base/gles2shader.h
new file mode 100644
index 0000000..9796f12
--- /dev/null
+++ b/Chowdren/base/gles2shader.h
@@ -0,0 +1,158 @@
+#ifndef CHOWDREN_GLES2SHADER_H
+#define CHOWDREN_GLES2SHADER_H
+
+// GL ES 2.0 support for the desktop shader layer (desktop/glslshader.cpp).
+// Included from include_gl.h after <GLES2/gl2.h> when CHOWDREN_USE_GLES2.
+//
+// ES 2.0 has the shader-object API in core under other names; glslshader.cpp
+// keeps the ARB spellings the desktop GL 2.1 build uses, remapped here. The
+// shader sources are the desktop GLSL 1.20 files (base/shaders, packed into
+// Assets.dat by the converter), rewritten at load time as GLSL ES 1.00 by
+// gles2_translate_shader() below.
+
+#include <ctype.h>
+#include <string.h>
+#include <string>
+#include "shadercommon.h"
+
+typedef GLuint GLhandleARB;
+typedef char GLcharARB;
+
+#define GL_VERTEX_SHADER_ARB GL_VERTEX_SHADER
+#define GL_FRAGMENT_SHADER_ARB GL_FRAGMENT_SHADER
+#define GL_OBJECT_COMPILE_STATUS_ARB GL_COMPILE_STATUS
+#define GL_OBJECT_LINK_STATUS_ARB GL_LINK_STATUS
+#define GL_OBJECT_INFO_LOG_LENGTH_ARB GL_INFO_LOG_LENGTH
+
+#define glCreateProgramObject glCreateProgram
+#define glCreateShaderObject glCreateShader
+#define glUseProgramObject glUseProgram
+#define glAttachObject glAttachShader
+#define glDetachObject glDetachShader
+
+// Program and shader names share one namespace in ES 2.0, so the ARB
+// object-generic queries dispatch on the kind of object.
+inline void chowdren_gles2_get_object_param(GLuint obj, GLenum pname,
+                                            GLint * value)
+{
+    if (glIsProgram(obj))
+        glGetProgramiv(obj, pname, value);
+    else
+        glGetShaderiv(obj, pname, value);
+}
+
+inline void chowdren_gles2_get_info_log(GLuint obj, GLsizei size,
+                                        GLsizei * length, GLchar * log)
+{
+    if (glIsProgram(obj))
+        glGetProgramInfoLog(obj, size, length, log);
+    else
+        glGetShaderInfoLog(obj, size, length, log);
+}
+
+#define glGetObjectParameteriv chowdren_gles2_get_object_param
+#define glGetInfoLog chowdren_gles2_get_info_log
+
+// The name of the varying that carries the vertex colour (gl_FrontColor in a
+// GLSL 1.20 vertex shader, gl_Color in its fragment shader).
+#define GLES2_COLOR_VARYING "chowdren_color"
+
+inline bool gles2_is_ident(char c)
+{
+    return isalnum((unsigned char)c) || c == '_';
+}
+
+// Rewrite a desktop GLSL 1.20 shader as GLSL ES 1.00:
+// - the #version line is dropped and "#version 100" leads a prologue;
+// - the fixed-function inputs become the attributes the renderer feeds
+//   (shadercommon.h *_ATTRIB_NAME, bound to *_ATTRIB_IDX before linking):
+//   gl_Vertex, gl_Color, gl_MultiTexCoord0 and gl_MultiTexCoord1;
+// - gl_FrontColor (vertex) and gl_Color (fragment) become one varying;
+// - the fragment stage gets a default float precision, highp where the GPU
+//   has it (GL_FRAGMENT_PRECISION_HIGH), as the desktop computes in fp32.
+// Identifiers are replaced whole-word only. Nothing else in the body
+// changes: the shaders are written to be valid in both dialects.
+inline std::string gles2_translate_shader(const char * src, size_t len,
+                                          bool vertex)
+{
+    static const char * const vert_map[][2] = {
+        {"gl_Vertex", POSITION_ATTRIB_NAME},
+        {"gl_Color", COLOR_ATTRIB_NAME},
+        {"gl_MultiTexCoord0", TEXCOORD1_ATTRIB_NAME},
+        {"gl_MultiTexCoord1", TEXCOORD2_ATTRIB_NAME},
+        {"gl_FrontColor", GLES2_COLOR_VARYING},
+        {NULL, NULL}
+    };
+    static const char * const frag_map[][2] = {
+        {"gl_Color", GLES2_COLOR_VARYING},
+        {NULL, NULL}
+    };
+    const char * const (*map)[2] = vertex ? vert_map : frag_map;
+
+    std::string out;
+    out.reserve(len + 512);
+    out += "#version 100\n";
+    if (vertex) {
+        out += "attribute vec4 " POSITION_ATTRIB_NAME ";\n"
+               "attribute vec4 " COLOR_ATTRIB_NAME ";\n"
+               "attribute vec4 " TEXCOORD1_ATTRIB_NAME ";\n"
+               "attribute vec4 " TEXCOORD2_ATTRIB_NAME ";\n";
+    } else {
+        out += "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+               "precision highp float;\n"
+               "#else\n"
+               "precision mediump float;\n"
+               "#endif\n";
+    }
+    out += "varying vec4 " GLES2_COLOR_VARYING ";\n";
+    // keep the body's line numbers readable in compiler logs
+    out += "#line 1\n";
+
+    size_t i = 0;
+    bool line_start = true;
+    while (i < len) {
+        char c = src[i];
+        if (line_start) {
+            // drop a "#version ..." line (leading blanks allowed)
+            size_t j = i;
+            while (j < len && (src[j] == ' ' || src[j] == '\t'))
+                j++;
+            if (j + 8 <= len && strncmp(src + j, "#version", 8) == 0) {
+                while (j < len && src[j] != '\n')
+                    j++;
+                // keep the newline so that line numbers still match
+                i = j;
+                line_start = false;
+                continue;
+            }
+        }
+        line_start = false;
+        if (c == '\n') {
+            out += c;
+            i++;
+            line_start = true;
+            continue;
+        }
+        if (c == 'g' && (i == 0 || !gles2_is_ident(src[i - 1]))) {
+            size_t j = i;
+            while (j < len && gles2_is_ident(src[j]))
+                j++;
+            std::string word(src + i, j - i);
+            const char * repl = NULL;
+            for (int k = 0; map[k][0] != NULL; k++) {
+                if (word == map[k][0]) {
+                    repl = map[k][1];
+                    break;
+                }
+            }
+            out += repl != NULL ? std::string(repl) : word;
+            i = j;
+            continue;
+        }
+        out += c;
+        i++;
+    }
+    return out;
+}
+
+#endif // CHOWDREN_GLES2SHADER_H
diff --git a/Chowdren/base/harness.cpp b/Chowdren/base/harness.cpp
index c2ff091..8f2ad89 100644
--- a/Chowdren/base/harness.cpp
+++ b/Chowdren/base/harness.cpp
@@ -572,13 +572,35 @@ bool harness_after_events(int frame_index)
 extern "C" void glReadPixels(int, int, int, int, unsigned int, unsigned int, void *);
 extern "C" void glPixelStorei(unsigned int, int);
 
+#ifdef CHOWDREN_USE_GLES2
+// GL ES 2.0 guarantees only RGBA / UNSIGNED_BYTE readback: read that and
+// keep the RGB bytes, the same pixels the desktop's GL_RGB read returns.
+static void harness_read_rgb(int width, int height, unsigned char * out)
+{
+    static std::vector<unsigned char> rgba;
+    size_t n = size_t(width) * height;
+    rgba.resize(n * 4);
+    glPixelStorei(0x0D05, 4);                                           // GL_PACK_ALIGNMENT
+    glReadPixels(0, 0, width, height, 0x1908, 0x1401, &rgba[0]);        // GL_RGBA, GL_UNSIGNED_BYTE
+    for (size_t i = 0; i < n; i++) {
+        out[i * 3] = rgba[i * 4];
+        out[i * 3 + 1] = rgba[i * 4 + 1];
+        out[i * 3 + 2] = rgba[i * 4 + 2];
+    }
+}
+#endif
+
 void harness_after_draw(int width, int height)
 {
     if (h_active && h_raw != NULL && (h_raw_draws++ % h_raw_every) == 0) {
         static std::vector<unsigned char> raw;
         raw.resize(size_t(WINDOW_WIDTH) * WINDOW_HEIGHT * 3);
+#ifdef CHOWDREN_USE_GLES2
+        harness_read_rgb(WINDOW_WIDTH, WINDOW_HEIGHT, &raw[0]);
+#else
         glPixelStorei(0x0D05, 1);                                          // GL_PACK_ALIGNMENT
         glReadPixels(0, 0, WINDOW_WIDTH, WINDOW_HEIGHT, 0x1907, 0x1401, &raw[0]);   // GL_RGB, GL_UNSIGNED_BYTE
+#endif
         if (fwrite(&raw[0], 1, raw.size(), h_raw) != raw.size()) {
             fprintf(stderr, "harness: raw video write failed; stopping the stream\n");
             fclose(h_raw);
@@ -592,8 +614,12 @@ void harness_after_draw(int width, int height)
     for (size_t i = 0; i < h_snaps.size(); i++) if (h_snaps[i] == here) wanted = true;
     if (!wanted) return;
     std::vector<unsigned char> px(size_t(width) * height * 3);
+#ifdef CHOWDREN_USE_GLES2
+    harness_read_rgb(width, height, &px[0]);
+#else
     glPixelStorei(0x0D05, 1);                                  // GL_PACK_ALIGNMENT
     glReadPixels(0, 0, width, height, 0x1907, 0x1401, &px[0]); // GL_RGB, GL_UNSIGNED_BYTE
+#endif
     const char * dir = getenv("CHOWDREN_SNAP_DIR");
     char path[512];
     snprintf(path, sizeof(path), "%s/frame%d-tick%d.ppm", dir && *dir ? dir : ".", here.first, here.second);
