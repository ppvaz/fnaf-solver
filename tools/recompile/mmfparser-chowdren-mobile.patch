diff --git a/Chowdren/base/objects/kyso.cpp b/Chowdren/base/objects/kyso.cpp
new file mode 100644
index 0000000..2db2aa2
--- /dev/null
+++ b/Chowdren/base/objects/kyso.cpp
@@ -0,0 +1,228 @@
+#include "objects/kyso.h"
+#include "collision.h"
+#include "common.h"
+#include "manager.h"
+
+// Extensions.CRunKyso (classes.dex), transcribed. The object shows image
+// `image` (rcImage) at its position minus the image hotspot, and nothing until
+// an image is chosen; the flags decide whether the first frame is shown at
+// creation (bit 5), when loading completes (bit 4), and whether it plays (bit
+// 0) or repeats (bit 1) from the start.
+
+KysoObject::KysoObject(int x, int y, int type_id)
+: FrameObject(x, y, type_id), images(NULL), anim_qty(0), image(NULL),
+  mode(0), load_frame(0), load_n_custom(1), loop_count(0), anim_counter(0),
+  anim_in_frame(0), anim_frame(0), anim_repeat(1), back_to_frame(0),
+  play_speed(100), anim_loop(false), playing(false), show_first_frame(false)
+{
+    collision = new InstanceBox(this);
+}
+
+KysoObject::~KysoObject()
+{
+    delete collision;
+}
+
+void KysoObject::init_kyso(Image ** images, int count, int mode, int flags,
+                           int play_speed, int back_to_frame)
+{
+    this->images = images;
+    anim_qty = count;
+    this->mode = mode;
+    this->play_speed = play_speed;
+    this->back_to_frame = back_to_frame;
+    anim_loop = (flags & 2) != 0;
+    playing = (flags & 1) != 0;
+    show_first_frame = (flags & 16) != 0;
+    bool first_frame_created = (flags & 32) != 0;
+    if (mode == 1)
+        load_all();
+    else if (mode == 3 || mode == 4 || mode == 5)
+        loop_count = manager.frame->loop_count;
+    if (mode != 1 && first_frame_created && anim_qty > 0) {
+        show(images[0]);
+        load_frame++;
+    }
+}
+
+void KysoObject::show(Image * img)
+{
+    image = img;
+    if (img == NULL)
+        return;
+    width = img->width;
+    height = img->height;
+    collision->update_aabb();
+}
+
+void KysoObject::load_all()
+{
+    load_frame = anim_qty;
+    if (show_first_frame && anim_qty > 0)
+        show(images[0]);
+}
+
+// handleRunObject: the loading modes only decide when "all loaded" fires and
+// when a first frame appears (every image is resident here), then Animation.
+void KysoObject::update()
+{
+    if (load_frame >= 0 && load_frame < anim_qty) {
+        int since = int(manager.frame->loop_count - loop_count);
+        switch (mode) {
+            case 1:
+                load_frame = anim_qty;
+                break;
+            case 3:
+                load_frame++;
+                load_n_custom = 1;
+                break;
+            case 4:
+                if (since % 2 == 0)
+                    load_frame++;
+                load_n_custom = 2;
+                break;
+            case 5:
+                if (since % 3 == 0)
+                    load_frame++;
+                load_n_custom = 3;
+                break;
+            case 6:
+                if (load_n_custom > 0 && since % load_n_custom == 0)
+                    load_frame++;
+                break;
+            case 9:
+                if (!playing && images[load_frame] != image &&
+                    load_n_custom > 0 && since % load_n_custom == 0)
+                    load_frame++;
+                break;
+        }
+        if (load_frame == anim_qty && show_first_frame)
+            show(images[0]);
+    }
+    if (anim_loop)
+        anim_repeat = 2;
+    if (!playing || anim_repeat <= 0)
+        return;
+    if (load_frame < anim_qty)
+        mode = 9;
+    if (animate() && anim_repeat == 0 && !anim_loop)
+        playing = false;
+}
+
+// Animation: the counter gains play_speed per loop and a frame advances each
+// time it passes 100. Past the last frame the flipbook returns to
+// back_to_frame - 1 (or 0); when the repeat count runs out it rests on the
+// last frame and reports the end.
+bool KysoObject::animate()
+{
+    int counter = anim_counter + play_speed;
+    int frame = anim_in_frame;
+    while (counter > 100) {
+        counter -= 100;
+        frame++;
+        if (frame < anim_qty)
+            continue;
+        frame = back_to_frame > 0 ? back_to_frame - 1 : 0;
+        if (anim_repeat == 0)
+            continue;
+        anim_repeat--;
+        if (anim_repeat != 0)
+            continue;
+        anim_frame = anim_qty - 1;
+        if (images[anim_frame] != image)
+            show(images[anim_frame]);
+        anim_counter = counter;
+        if (!anim_loop)
+            anim_in_frame = frame;
+        return true;
+    }
+    if (frame < 0)
+        frame = 0;
+    anim_counter = counter;
+    if (images[frame] != image)
+        show(images[frame]);
+    anim_in_frame = frame;
+    anim_frame = frame;
+    return false;
+}
+
+void KysoObject::draw()
+{
+    if (image == NULL)
+        return;
+    draw_image(image, x, y, blend_color);
+}
+
+void KysoObject::load_mode(int value)
+{
+    mode = value;
+    if (mode > 5)
+        mode = 5;
+    if (mode < 0)
+        mode = 0;
+    if (mode == 1) {
+        load_all();
+        return;
+    }
+    if (mode == 3 || mode == 4 || mode == 5)
+        loop_count = manager.frame->loop_count;
+}
+
+void KysoObject::load_custom(int value)
+{
+    load_n_custom = value;
+    if (value <= 0)
+        return;
+    mode = 6;
+    loop_count = manager.frame->loop_count;
+}
+
+void KysoObject::play()
+{
+    anim_repeat = 1;
+    anim_counter = 0;
+    anim_in_frame = 0;
+    playing = true;
+}
+
+void KysoObject::play_loop(int count)
+{
+    anim_repeat = count;
+    if (count == 0)
+        anim_loop = true;
+    anim_counter = 0;
+    anim_in_frame = 0;
+    playing = true;
+}
+
+void KysoObject::reset()
+{
+    anim_repeat = 0;
+    anim_counter = 0;
+    anim_in_frame = 0;
+    anim_frame = 0;
+    if (anim_qty > 0)
+        show(images[0]);
+    playing = false;
+    anim_loop = false;
+}
+
+void KysoObject::set_speed(int value)
+{
+    play_speed = std::max(0, std::min(100, value));
+}
+
+void KysoObject::set_back_to_frame(int value)
+{
+    back_to_frame = std::max(0, std::min(anim_qty - 1, value));
+}
+
+bool KysoObject::is_playing()
+{
+    return playing;
+}
+
+bool KysoObject::is_anim(int value)
+{
+    return anim_frame == value;
+}
diff --git a/Chowdren/base/objects/kyso.h b/Chowdren/base/objects/kyso.h
new file mode 100644
index 0000000..9aec913
