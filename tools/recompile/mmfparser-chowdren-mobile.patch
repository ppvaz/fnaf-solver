diff --git a/Chowdren/base/harness.h b/Chowdren/base/harness.h
new file mode 100644
index 0000000..2c07c96
--- /dev/null
+++ b/Chowdren/base/harness.h
@@ -0,0 +1,112 @@
+#ifndef CHOWDREN_HARNESS_H
+#define CHOWDREN_HARNESS_H
+
+// Deterministic research harness for the build-296 recompile (ROADMAP S2b).
+//
+// Fusion's event-sheet Random(N) is CRun.random: graine = graine * 31415 + 1
+// (mod 2^16), result (graine * N) >> 16, and every frame load reseeds graine
+// from (short) System.currentTimeMillis() (packages/core rng.js cites the dex).
+// Chowdren's cross_rand is a different LCG, so randrange_event and pick_random
+// go through fusion_random below, always.
+//
+// With CHOWDREN_HARNESS=1 in the environment the harness also:
+//   - steps every frame by exactly 1/60 s and never sleeps (CHOWDREN_FIXED_STEP),
+//   - seeds a frame load from CHOWDREN_SEED (low 16 bits) instead of the clock,
+//     optionally only for the frame index in CHOWDREN_SEED_FRAME,
+//   - replays touches from CHOWDREN_INPUT, one per line:
+//       <frameIndex> <tick> down|move|up <pointer> [<x> <y>]
+//     where <tick> counts the frame's event updates from 0 and x, y are window
+//     pixels (the game's 1024x768 window, before scroll),
+//   - writes one line per event update to CHOWDREN_TRACE: frame index, tick,
+//     Random draws so far this frame load, graine, and the global values,
+//   - writes CHOWDREN_SNAP frames (see harness_after_draw),
+//   - optionally replaces the fixed step of one frame visit with measured
+//     per-update times (CHOWDREN_FRAME_TIMES, below) and traces overlaps
+//     (CHOWDREN_WATCH_OVERLAP, harness.cpp),
+//   - skips drawing when CHOWDREN_NO_DRAW=1, and exits after CHOWDREN_MAX_TICKS
+//     event updates of the frame index in CHOWDREN_STOP_FRAME; always exits
+//     after CHOWDREN_MAX_TOTAL_TICKS updates across all frames (default 60000).
+// Input rows fire once on the first matching frame visit reaching their tick;
+// frame indices need not increase during navigation.
+
+#include <vector>
+
+extern unsigned int fusion_graine;
+extern unsigned int fusion_draws;
+
+inline int fusion_random(int range)
+{
+    fusion_graine = (fusion_graine * 31415u + 1u) & 0xFFFFu;
+    fusion_draws++;
+    return (int)((fusion_graine * (unsigned int)(range & 0xFFFF)) >> 16);
+}
+
+// Multiple Touch state, shaped like the Android runtime's
+// CRunMultipleTouch$MultiTouch: a list of slots, a slot is reused when free,
+// and a touch's number is its slot index.
+struct HarnessTouch
+{
+    bool free;
+    int id;
+    float x, y, start_x, start_y, drag_x, drag_y;
+};
+
+struct HarnessMultiTouch
+{
+    std::vector<HarnessTouch> touches;
+    int touch_count, last_touch, last_new_touch, last_end_touch, last_new_touch_id;
+    // Triggered conditions fire from generateEvent on the Android runtime; the
+    // harness holds each trigger true for the event update that follows the
+    // touch change.
+    bool new_touch, end_touch, moved_touch;
+};
+
+extern HarnessMultiTouch harness_touch;
+
+bool harness_active();
+bool harness_fixed_step();
+bool harness_skip_draw();
+bool harness_realtime();
+// CHOWDREN_FRAME_TIMES=<file>: one timer delta in ms per line ('#' comments),
+// line k for update k of the first visit to frame CHOWDREN_FRAME_TIMES_FRAME.
+// That update's manager.dt (so the frame timer, global value 5's source) and
+// timer_units (CND_EVERY2's delta, round(ms * 3)) come from the line; every
+// other update, and updates past the list, keep the fixed 1/60 s step. A
+// replay then runs on a measured clock (the phone's frame trace) instead.
+// Returns false when no line applies to the update about to run.
+bool harness_frame_ms(double * ms);
+// The clock a channel's playing state and position follow under the harness
+// (media.cpp): seconds, the sum of every update's delta so far, so a sound
+// ends after its decoded length of game time however fast the steps run.
+double harness_audio_time();
+int harness_frame_index();
+int harness_tick();
+void harness_init();
+void harness_seed_frame(int index);
+void harness_before_events(int frame_index);
+bool harness_after_events(int frame_index);
+// CHOWDREN_SNAP=frame:tick[,frame:tick...]: after drawing the state that follows
+// that update, write the window as a binary PPM to CHOWDREN_SNAP_DIR (default .).
+void harness_after_draw(int width, int height);
+
+// Multiple Touch ACEs (condition/expression numbers as the Android runtime's
+// CRunMultipleTouch.condition / .expression switch them).
+bool mt_new_touch(int id);          // condition 0
+bool mt_end_touch(int id);          // condition 1
+bool mt_any_new_touch();            // condition 2
+bool mt_any_end_touch();            // condition 3
+bool mt_moved_touch(int id);        // condition 4
+bool mt_touch_active(int id);       // condition 5
+bool mt_touch_point(int id, int * x, int * y); // for 6/7: the touch in frame coordinates
+int mt_touch_count();               // expression 0
+int mt_last_touch();                // expression 1
+int mt_touch_x(int id);             // expression 2
+int mt_touch_y(int id);             // expression 3
+int mt_last_new_touch();            // expression 4
+int mt_last_end_touch();            // expression 5
+int mt_start_x(int id);             // expression 6
+int mt_start_y(int id);             // expression 7
+int mt_drag_x(int id);              // expression 8
+int mt_drag_y(int id);              // expression 9
+
+#endif // CHOWDREN_HARNESS_H
