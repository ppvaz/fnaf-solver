+#ifndef CHOWDREN_CHILD_EVENTS_H
+#define CHOWDREN_CHILD_EVENTS_H
+
+#include <map>
+#include <vector>
+class ObjectList;
+class FrameObject;
+
+// Each nested child invocation inherits the enclosing snapshot, then replaces
+// only selections explicitly captured by its parent. Siblings read the same
+// snapshot; a child's filtering must not narrow the next sibling.
+class ChildEventSelection
+{
+public:
+    typedef std::vector<FrameObject *> Objects;
+    typedef std::map<ObjectList *, Objects> Snapshot;
+    std::vector<Snapshot> stack;
+
+    void push()
+    {
+        Snapshot inherited;
+        if (!stack.empty()) inherited = stack.back();
+        stack.push_back(inherited);
+    }
+    void pop() { stack.pop_back(); }
+    void save(ObjectList * list, const Objects & objects)
+    {
+        stack.back()[list] = objects;
+    }
+    const Objects * get(ObjectList * list) const
+    {
+        if (stack.empty()) return NULL;
+        Snapshot::const_iterator it = stack.back().find(list);
+        return it == stack.back().end() ? NULL : &it->second;
+    }
+};
+
+class ChildEventScope
+{
+    ChildEventSelection & selections;
+public:
+    ChildEventScope(ChildEventSelection & value) : selections(value)
+    { selections.push(); }
+    ~ChildEventScope() { selections.pop(); }
+private:
+    ChildEventScope(const ChildEventScope &);
+    ChildEventScope & operator=(const ChildEventScope &);
+};
+
+#endif
diff --git a/Chowdren/chowdren/child_events.py b/Chowdren/chowdren/child_events.py
new file mode 100644
index 0000000..0caa5f5
--- /dev/null
+++ b/Chowdren/chowdren/child_events.py
@@ -0,0 +1,37 @@
+"""Build-296 child lists, not editor event-group containers.
+
+The Android runtime opens a list on flag 0x40/action43 and closes it on
+system condition -42. Flag0x8000 selects the current nested list. Only
+polled children are supported here; reject other shapes rather than flatten.
+"""
+
+
+def partition_child_events(items):
+    roots, children, stack = [], {}, []
+    for index, group in enumerate(items):
+        first = group.conditions[0]
+        is_end = first.objectType == -1 and first.num == -42
+        if is_end:
+            if not stack:
+                raise ValueError('orphan child-list end at %s' % index)
+            stack.pop()
+            continue
+        flags = group.flags.getFlags()
+        if bool(flags & 0x8000) != bool(stack):
+            raise ValueError('child nesting flag mismatch at %s' % index)
+        if stack:
+            if not first.flags['Always']:
+                raise NotImplementedError('triggered child at %s' % index)
+            children[stack[-1]].append(index)
+        else:
+            roots.append(index)
+        actions = [a for a in group.actions
+                   if a.objectType == -1 and a.num == 43]
+        if bool(flags & 0x40) != bool(actions) or len(actions) > 1:
+            raise ValueError('child action/flag mismatch at %s' % index)
+        if actions:
+            children[index] = []
+            stack.append(index)
+    if stack:
+        raise ValueError('unclosed child lists: %r' % stack)
+    return roots, children
