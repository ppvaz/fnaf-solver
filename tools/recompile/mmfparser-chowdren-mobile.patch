+// The whole mix pauses while the app is in the background, as the retail
+// runtime's sound player does, and resumes in the foreground. SDL posts these
+// app events from the Android UI thread and, blocking on pause, pumps no
+// events until the app resumes, so they are caught by a watch, not the queue.
+// Leaving the rebuild at its title in the background kept its music playing
+// over other apps (2026-09-27).
+static int SDLCALL app_event_watch(void * userdata, SDL_Event * e)
+{
+    if (e->type == SDL_APP_WILLENTERBACKGROUND)
+        media.set_device_paused(true);
+    else if (e->type == SDL_APP_DIDENTERFOREGROUND)
+        media.set_device_paused(false);
+    return 1;
+}
