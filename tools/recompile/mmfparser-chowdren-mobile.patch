diff --git a/Chowdren/chowdren/writers/extensions/MultipleTouch.py b/Chowdren/chowdren/writers/extensions/MultipleTouch.py
new file mode 100644
index 0000000..784af36
--- /dev/null
+++ b/Chowdren/chowdren/writers/extensions/MultipleTouch.py
@@ -0,0 +1,171 @@
+# Multiple Touch (Android runtime: Extensions/CRunMultipleTouch). The ACE
+# numbers are the runtime's own switch cases, read from classes.dex:
+#   conditions  0 new touch(id)   1 end touch(id)   2 any new touch
+#               3 any end touch   4 moved touch(id) 5 touch(id) active
+#               6 new touch on object              7 touch(id) on object
+#               8 new pinch  9 pinch active  10 new gesture (not emulated: false)
+#   expressions 0 touch count  1 last touch  2 X(id)  3 Y(id)  4 last new touch
+#               5 last end touch  6 start X(id)  7 start Y(id)  8 drag dX(id)
+#               9 drag dY(id)  10.. drag angle/distance, pinch, gesture (-1)
+# State and semantics live in base/harness.{h,cpp}; touches come from the
+# harness input script.
+
+from chowdren.writers.objects import ObjectWriter
+from chowdren.writers.events import ConditionWriter, ExpressionWriter
+
+
+class MultipleTouch(ObjectWriter):
+    # Instance-bearing, like the patch's UnsupportedExtensionObject: the event
+    # sheet keeps its touch bookkeeping in this object's alterable values.
+    class_name = 'FrameObject'
+    use_alterables = True
+
+
+def write_touch_over(writer, cond, touch, obj, guard=None):
+    """Touch-on-object as the Android runtime evaluates an extension
+    condition: one boolean for the object list, which NOT inverts
+    (CCnd.negaTRUE / negaFALSE). Positive keeps the instances under the touch;
+    negated holds only when the touch is over none of them and leaves the
+    selection alone. Chowdren's default per-instance NOT made group 36's
+    `NOT touch(MT6) on cameraHitbox` true whenever any of the twelve hitboxes
+    was untouched, so the camera touch was wiped the loop after it began and
+    no camera button ever switched."""
+    converter = cond.converter
+    negated = cond.data.otherFlags['Not']
+    end = converter.event_break
+    if negated:
+        selected = converter.get_object_list(obj)
+    else:
+        selected = converter.create_list(obj, writer)
+    iter_type = converter.get_iter_type(obj)
+    test = '((FrameObject*)*it)->touch_over(%s)' % touch
+    if guard and not negated:
+        writer.putlnc('if (!(%s)) %s', guard, end)
+    writer.putlnc('{')
+    writer.indent()
+    writer.putlnc('bool touch_hit = false;')
+    writer.putlnc('for (%s it(%s); !it.end(); ++it) {', iter_type, selected)
+    writer.indent()
+    if negated:
+        writer.putlnc('if (%s) { touch_hit = true; break; }', test)
+    else:
+        writer.putlnc('if (!(%s)) { it.deselect(); continue; }', test)
+        writer.putlnc('touch_hit = true;')
+    writer.dedent()
+    writer.putlnc('}')
+    if negated and guard:
+        writer.putlnc('if ((%s) && touch_hit) %s', guard, end)
+    elif negated:
+        writer.putlnc('if (touch_hit) %s', end)
+    else:
+        writer.putlnc('if (!touch_hit) %s', end)
+    writer.dedent()
+    writer.putlnc('}')
+
+
+class TouchOnObject(ConditionWriter):
+    """7: touch(id) is over the object parameter's instances."""
+    has_object = False
+    custom = True
+
+    def write(self, writer):
+        data = self.parameters[1].loader
+        write_touch_over(writer, self, self.convert_index(0),
+                         (data.objectInfo, data.objectType))
+
+    def is_negated(self):
+        return False
+
+
+class NewTouchOnObject(ConditionWriter):
+    """6: the new touch of this update is over the object's instances."""
+    # The harness holds this trigger for one event update. Without forcing
+    # polling, Chowdren parks the row in an unimplemented generated group.
+    is_always = True
+    has_object = False
+    custom = True
+
+    def write(self, writer):
+        data = self.parameters[0].loader
+        write_touch_over(writer, self, 'harness_touch.last_new_touch',
+                         (data.objectInfo, data.objectType),
+                         guard='harness_touch.new_touch')
+
+    def is_negated(self):
+        return False
+
+
+class NeverCondition(ConditionWriter):
+    has_object = False
+
+    def write(self, writer):
+        writer.put('false')
+
+
+class MinusOne(ExpressionWriter):
+    """Pinch, gesture and drag-angle/distance expressions: the runtime's -1."""
+    has_object = False
+
+    def get_string(self):
+        return '(-1)'
+
+
+def free_condition(fmt):
+    """A condition on the global touch state: a free function, not a method
+    (a static writer would prefix the placeholder class, FrameObject::)."""
+    class FreeCondition(ConditionWriter):
+        has_object = False
+        is_always = True
+
+        def write(self, writer):
+            if '%s' in fmt:
+                writer.put(fmt % self.convert_index(0))
+            else:
+                writer.put(fmt)
+    return FreeCondition
+
+
+def free_expression(text):
+    """`name(` takes the expression's own parameters; `name()` takes none."""
+    class FreeExpression(ExpressionWriter):
+        has_object = False
+
+        def get_string(self):
+            return text
+    return FreeExpression
+
+
+conditions = {
+    0: free_condition('mt_new_touch(%s)'),
+    1: free_condition('mt_end_touch(%s)'),
+    2: free_condition('mt_any_new_touch()'),
+    3: free_condition('mt_any_end_touch()'),
+    4: free_condition('mt_moved_touch(%s)'),
+    5: free_condition('mt_touch_active(%s)'),
+    6: NewTouchOnObject,
+    7: TouchOnObject,
+    8: NeverCondition,
+    9: NeverCondition,
+    10: NeverCondition,
+}
+
+actions = {}
+
+expressions = {
+    0: free_expression('mt_touch_count()'),
+    1: free_expression('mt_last_touch()'),
+    2: free_expression('mt_touch_x('),
+    3: free_expression('mt_touch_y('),
+    4: free_expression('mt_last_new_touch()'),
+    5: free_expression('mt_last_end_touch()'),
+    6: free_expression('mt_start_x('),
+    7: free_expression('mt_start_y('),
+    8: free_expression('mt_drag_x('),
+    9: free_expression('mt_drag_y('),
+    10: MinusOne, 11: MinusOne, 12: MinusOne, 13: MinusOne, 14: MinusOne,
+    15: MinusOne, 16: MinusOne,
+}
+
+
+def get_object():
+    return MultipleTouch
