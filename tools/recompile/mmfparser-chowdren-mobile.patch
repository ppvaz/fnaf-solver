+static void redirect_stdio()
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    setvbuf(stderr, NULL, _IONBF, 0);
+    int pfd[2];
+    if (pipe(pfd) != 0)
+        return;
+    dup2(pfd[1], 1);
+    dup2(pfd[1], 2);
+    close(pfd[1]);
+    pthread_t t;
+    pthread_create(&t, NULL, stdio_to_logcat, (void*)(intptr_t)pfd[0]);
+    pthread_detach(t);
+}
