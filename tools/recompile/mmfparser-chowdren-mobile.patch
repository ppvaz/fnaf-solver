+// Deterministic research harness for the build-296 recompile. See harness.h.
+// Compiled once, included from run.cpp next to crashdump.cpp.
+
+#include "harness.h"
+#include "platform.h"
+#include <SDL.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <time.h>
+#include <string>
+
+unsigned int fusion_graine = 0;
+unsigned int fusion_draws = 0;
+HarnessMultiTouch harness_touch;
+
+namespace {
+
+struct InputRow { int frame_index, tick, op, pointer; float x, y; std::string object; bool consumed; };
+enum { OP_DOWN = 0, OP_MOVE = 1, OP_UP = 2, OP_DOWN_OBJECT = 3 };
+
+bool h_active = false, h_no_draw = false;
+// CHOWDREN_REALTIME=1: keep the fixed 60 Hz steps but pace them at real time, so a person can watch a replay.
+bool h_realtime = false;
+// CHOWDREN_RAWVIDEO=<path>: after every CHOWDREN_RAWVIDEO_EVERY-th draw (default 2, so 30 fps of the
+// 60 Hz updates) write the game's own WINDOW_WIDTH x WINDOW_HEIGHT frame buffer as raw RGB, rows bottom-up,
+// to <path> (a FIFO an encoder reads). It reads the screen FBO before the window blit, like the snapshots,
+// so nothing else on the desktop can appear in it and the window can be tiny.
+static FILE * h_raw = NULL;
+static int h_raw_every = 2;
+static long h_raw_draws = 0;
+// CHOWDREN_PLAY=1 without the harness: the real left mouse button is touch 0.
+bool h_play = false, h_play_down = false;
+std::vector<std::pair<int, int> > h_snaps;   // (frame index, update) to write after drawing
+int h_seed = -1, h_seed_frame = -1, h_stop_frame = -1, h_max_ticks = -1, h_dump_frame = -1, h_dump_tick = -1;
+int h_tick = 0, h_frame_index = -1, h_total_ticks = 0, h_max_total_ticks = 60000;
+std::vector<InputRow> h_inputs;
+FILE * h_trace = NULL;
+// Android pointer id -> slot index, for up/move rows.
+std::vector<int> h_pointer_slot;
+
+int env_int(const char * name, int fallback)
+{
+    const char * v = getenv(name);
+    return v && *v ? atoi(v) : fallback;
+}
+
+void load_inputs(const char * path)
+{
+    FILE * f = fopen(path, "r");
+    if (f == NULL) {
+        fprintf(stderr, "harness: cannot open CHOWDREN_INPUT %s\n", path);
+        exit(3);
+    }
+    char line[256];
+    while (fgets(line, sizeof line, f)) {
+        if (line[0] == '#' || line[0] == '\n')
+            continue;
+        InputRow r; char op[16]; r.x = r.y = 0.0f; r.consumed = false; int used = 0;
+        int n = sscanf(line, "%d %d %15s %d %n", &r.frame_index, &r.tick, op, &r.pointer, &used);
+        if (n < 4) { fprintf(stderr, "harness: bad input line: %s", line); exit(3); }
+        if (!strcmp(op, "downobj")) {
+            // The rest of the line is an object name: touch the centre of its
+            // first live instance's collision box when the row comes due.
+            std::string name(line + used);
+            while (!name.empty() && (name[name.size() - 1] == '\n' || name[name.size() - 1] == '\r' || name[name.size() - 1] == ' '))
+                name.erase(name.size() - 1);
+            r.op = OP_DOWN_OBJECT; r.object = name;
+            h_inputs.push_back(r);
+            continue;
+        }
+        sscanf(line + used, "%f %f", &r.x, &r.y);
+        if (!strcmp(op, "down")) r.op = OP_DOWN;
+        else if (!strcmp(op, "move")) r.op = OP_MOVE;
+        else if (!strcmp(op, "up")) r.op = OP_UP;
+        else { fprintf(stderr, "harness: bad op %s\n", op); exit(3); }
+        h_inputs.push_back(r);
+    }
+    fclose(f);
+}
+
+void new_touch(int pointer, float x, float y, bool drive_mouse = true)
+{
+    HarnessMultiTouch & m = harness_touch;
+    int slot = -1;
+    for (size_t i = 0; i < m.touches.size(); i++)
+        if (m.touches[i].free) { slot = int(i); break; }
+    HarnessTouch t; t.free = false; t.id = pointer;
+    t.x = t.start_x = t.drag_x = x; t.y = t.start_y = t.drag_y = y;
+    if (slot < 0) { slot = int(m.touches.size()); m.touches.push_back(t); }
+    else m.touches[slot] = t;
+    m.last_new_touch = m.last_touch = slot;
+    m.last_new_touch_id = pointer;
+    m.touch_count++;
+    m.new_touch = true;
+    if (pointer >= int(h_pointer_slot.size())) h_pointer_slot.resize(pointer + 1, -1);
+    h_pointer_slot[pointer] = slot;
+    // The first touch is the mouse on Android.
+    if (slot == 0 && drive_mouse) {
+        manager.mouse_x = int(x); manager.mouse_y = int(y);
+        manager.on_mouse(SDL_BUTTON_LEFT, true);
+    }
+}
+
+void end_touch(int pointer, bool drive_mouse = true)
+{
+    HarnessMultiTouch & m = harness_touch;
+    if (pointer >= int(h_pointer_slot.size()) || h_pointer_slot[pointer] < 0) return;
+    int slot = h_pointer_slot[pointer];
+    h_pointer_slot[pointer] = -1;
+    m.touches[slot].free = true;
+    m.last_end_touch = m.last_touch = slot;
+    m.touch_count--;
+    m.end_touch = true;
+    if (slot == 0 && drive_mouse) manager.on_mouse(SDL_BUTTON_LEFT, false);
+}
+
+void move_touch(int pointer, float x, float y, bool drive_mouse = true)
+{
+    HarnessMultiTouch & m = harness_touch;
+    if (pointer >= int(h_pointer_slot.size()) || h_pointer_slot[pointer] < 0) return;
+    int slot = h_pointer_slot[pointer];
+    HarnessTouch & t = m.touches[slot];
+    t.x = t.drag_x = x; t.y = t.drag_y = y;
+    m.last_touch = slot;
+    m.moved_touch = true;
+    if (slot == 0 && drive_mouse) { manager.mouse_x = int(x); manager.mouse_y = int(y); }
+}
+
+// Window point at the centre of the first live instance named `name`: the
+// collision box is in layer coordinates, and a touch's frame point is the
+// window point plus the frame scroll (mt_touch_point), less the layer offset.
+bool object_center(const std::string & name, float * x, float * y)
+{
+    Frame * f = manager.frame;
+    for (size_t li = 0; li < f->layers.size(); li++) {
+        Layer & layer = f->layers[li];
+        for (LayerInstances::iterator it = layer.instances.begin(); it != layer.instances.end(); ++it) {
+            FrameObject & obj = *it;
+            if (obj.flags & DESTROYING) continue;
+            if (obj.get_name() != name || obj.collision == NULL) continue;
+            int * b = obj.collision->aabb;
+            *x = (b[0] + b[2]) * 0.5f + layer.off_x - f->off_x;
+            *y = (b[1] + b[3]) * 0.5f + layer.off_y - f->off_y;
+            return true;
+        }
+    }
+    return false;
+}
+
+HarnessTouch * touch_at(int id)
+{
+    if (id < 0 || id >= int(harness_touch.touches.size())) return NULL;
+    HarnessTouch * t = &harness_touch.touches[id];
+    return t;
+}
+
+} // namespace
+
+bool harness_active() { return h_active; }
+bool harness_fixed_step() { return h_active; }
+
+// The harness audio clock (harness.h): the sum of the update deltas so far.
+static double h_audio_time = 0.0;
+double harness_audio_time() { return h_audio_time; }
+int harness_frame_index() { return h_frame_index; }
+int harness_tick() { return h_tick; }
+
+// CHOWDREN_FRAME_TIMES / CHOWDREN_FRAME_TIMES_FRAME (harness.h): measured per-update
+// timer deltas in ms for the first visit to one frame index.
+static std::vector<double> h_frame_times;
+static int h_frame_times_frame = -1, h_frame_times_visits = 0;
+
+static void load_frame_times(const char * path)
+{
+    h_frame_times_frame = env_int("CHOWDREN_FRAME_TIMES_FRAME", -1);
+    if (h_frame_times_frame < 0) {
+        fprintf(stderr, "harness: CHOWDREN_FRAME_TIMES needs CHOWDREN_FRAME_TIMES_FRAME\n");
+        exit(3);
+    }
+    FILE * f = fopen(path, "r");
+    if (f == NULL) {
+        fprintf(stderr, "harness: cannot open CHOWDREN_FRAME_TIMES %s\n", path);
+        exit(3);
+    }
+    char line[128];
+    while (fgets(line, sizeof line, f)) {
+        if (line[0] == '#' || line[0] == '\n')
+            continue;
+        double ms;
+        if (sscanf(line, "%lf", &ms) != 1 || !(ms > 0.0) || ms > 60000.0) {
+            fprintf(stderr, "harness: bad frame time line: %s", line);
+            exit(3);
+        }
+        h_frame_times.push_back(ms);
+    }
+    fclose(f);
+    if (h_frame_times.empty()) {
+        fprintf(stderr, "harness: CHOWDREN_FRAME_TIMES %s holds no times\n", path);
+        exit(3);
+    }
+}
+
+bool harness_frame_ms(double * ms)
+{
+    if (!h_active || h_frame_times.empty() || h_frame_index != h_frame_times_frame || h_frame_times_visits != 1)
+        return false;
+    if (h_tick < 0 || h_tick >= int(h_frame_times.size()))
+        return false;
+    *ms = h_frame_times[h_tick];
+    return true;
+}
+// CHOWDREN_DRAW_FROM=<frame>:<tick>: draw nothing (as CHOWDREN_NO_DRAW) until that frame reaches that tick, then
+// draw every update. A clip from the middle of a night runs at headless speed up to its first frame.
+static int h_draw_from_frame = -1, h_draw_from_tick = 0;
+static bool h_drawing = true;
+static double h_draw_wall = -1.0;
+static double wall_now() { struct timespec t; clock_gettime(CLOCK_REALTIME, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
+bool harness_skip_draw()
+{
+    if (h_no_draw) return true;
+    if (!h_drawing && h_frame_index == h_draw_from_frame && h_tick >= h_draw_from_tick) {
+        // CHOWDREN_DRAW_GO=<path>: hold here until <path> exists, so several instances start drawing together.
+        const char * go = getenv("CHOWDREN_DRAW_GO");
+        if (go && *go) {
+            fprintf(stderr, "harness: ready at frame %d tick %d\n", h_frame_index, h_tick);
+            fflush(stderr);
+            FILE * f;
+            while ((f = fopen(go, "rb")) == NULL) platform_sleep(0.002);
+            fclose(f);
+        }
+        h_drawing = true;
+        h_draw_wall = wall_now();
+        fprintf(stderr, "harness: drawing from frame %d tick %d wall %.3f\n", h_frame_index, h_tick, h_draw_wall);
+        fflush(stderr);
+    }
+    return !h_drawing;
+}
+bool harness_realtime() { return h_realtime && h_drawing; }
+
+void harness_init()
+{
+    HarnessMultiTouch & m = harness_touch;
+    m.touch_count = 0;
+    m.last_touch = m.last_new_touch = m.last_end_touch = m.last_new_touch_id = -1;
+    m.new_touch = m.end_touch = m.moved_touch = false;
+    h_active = env_int("CHOWDREN_HARNESS", 0) != 0;
+    if (!h_active) {
+#ifdef CHOWDREN_IS_ANDROID
+        // The on-device build is played by a person: touch drives touch 0 through
+        // SDL's touch-to-mouse events, as the desktop play mode does with a mouse.
+        h_play = true;
+#else
+        h_play = env_int("CHOWDREN_PLAY", 0) != 0;
+#endif
+        if (h_play) fprintf(stderr, "harness: play mode, the left mouse button is touch 0\n");
+        return;
+    }
+    h_no_draw = env_int("CHOWDREN_NO_DRAW", 0) != 0;
+    h_realtime = env_int("CHOWDREN_REALTIME", 0) != 0;
+    {
+        const char * df = getenv("CHOWDREN_DRAW_FROM");
+        if (df && *df && sscanf(df, "%d:%d", &h_draw_from_frame, &h_draw_from_tick) == 2) h_drawing = false;
+    }
+    {
+        const char * rv = getenv("CHOWDREN_RAWVIDEO");
+        if (rv && *rv) {
+            h_raw = fopen(rv, "wb");
+            h_raw_every = env_int("CHOWDREN_RAWVIDEO_EVERY", 2);
+            if (h_raw_every < 1) h_raw_every = 1;
+            fprintf(stderr, "harness: raw video %dx%d every %d draws -> %s%s\n", WINDOW_WIDTH, WINDOW_HEIGHT,
+                    h_raw_every, rv, h_raw ? "" : " (open failed)");
+        }
+    }
+    h_seed = env_int("CHOWDREN_SEED", -1);
+    h_seed_frame = env_int("CHOWDREN_SEED_FRAME", -1);
+    h_stop_frame = env_int("CHOWDREN_STOP_FRAME", -1);
+    h_max_ticks = env_int("CHOWDREN_MAX_TICKS", -1);
+    h_max_total_ticks = env_int("CHOWDREN_MAX_TOTAL_TICKS", 60000);
+    if (h_max_total_ticks <= 0) {
+        fprintf(stderr, "harness: CHOWDREN_MAX_TOTAL_TICKS must be positive\n");
+        exit(3);
+    }
+    const char * snaps = getenv("CHOWDREN_SNAP");
+    for (const char * s = snaps; s && *s; ) {
+        int f = -1, t = -1;
+        if (sscanf(s, "%d:%d", &f, &t) == 2) h_snaps.push_back(std::make_pair(f, t));
+        s = strchr(s, ',');
+        if (s) s++;
+    }
+    h_dump_frame = env_int("CHOWDREN_DUMP_FRAME", -1);
+    h_dump_tick = env_int("CHOWDREN_DUMP_TICK", 1);
+    const char * input = getenv("CHOWDREN_INPUT");
+    if (input && *input) load_inputs(input);
+    const char * times = getenv("CHOWDREN_FRAME_TIMES");
+    if (times && *times) load_frame_times(times);
+    const char * trace = getenv("CHOWDREN_TRACE");
+    if (trace && *trace) {
+        h_trace = fopen(trace, "w");
+        if (h_trace == NULL) { fprintf(stderr, "harness: cannot open CHOWDREN_TRACE %s\n", trace); exit(3); }
+        fprintf(h_trace, "# frame tick draws graine values...\n");
+        if (!h_frame_times.empty())
+            fprintf(h_trace, "# frametimes %d updates of frame %d\n", int(h_frame_times.size()), h_frame_times_frame);
+    }
+    if (!h_frame_times.empty())
+        fprintf(stderr, "harness: %d measured update times for the first visit to frame %d\n",
+                int(h_frame_times.size()), h_frame_times_frame);
+    fprintf(stderr, "harness: on (seed %d frame %d, %d inputs, stop frame %d after %d ticks)\n",
+            h_seed, h_seed_frame, int(h_inputs.size()), h_stop_frame, h_max_ticks);
+}
+
+void harness_seed_frame(int index)
+{
+    // CRun.allocRunHeader: every frame load takes (short) currentTimeMillis.
+    unsigned int seed = (unsigned int)((long long)(platform_get_global_time() * 1000.0)) & 0xFFFFu;
+    if (h_active && h_seed >= 0 && (h_seed_frame < 0 || h_seed_frame == index))
+        seed = (unsigned int)h_seed & 0xFFFFu;
+    fusion_graine = seed;
+    fusion_draws = 0;
+    h_frame_index = index;
+    h_tick = 0;
+    if (index == h_frame_times_frame) h_frame_times_visits++;
+    if (h_trace) fprintf(h_trace, "# frame %d seeded %u\n", index, seed);
+}
+
+// CHOWDREN_DUMP_FRAME/TICK: list every live instance -- layer, name, collision
+// box -- so an input script can name what it touches.
+void dump_instances(int frame_index)
+{
+    Frame * f = manager.frame;
+    for (size_t li = 0; li < f->layers.size(); li++) {
+        Layer & layer = f->layers[li];
+        for (LayerInstances::iterator it = layer.instances.begin(); it != layer.instances.end(); ++it) {
+            FrameObject & obj = *it;
+            int * b = obj.collision ? obj.collision->aabb : NULL;
+            fprintf(stderr, "harness: instance frame %d layer %d '%s' box %d %d %d %d", frame_index, int(li),
+                    obj.get_name().c_str(), b ? b[0] : -1, b ? b[1] : -1, b ? b[2] : -1, b ? b[3] : -1);
+            if (obj.alterables) {
+                fprintf(stderr, " values");
+                for (int v = 0; v < 10; v++) fprintf(stderr, " %g", double(obj.alterables->values.get(v)));
+                fprintf(stderr, " flag0 %d", int(obj.alterables->flags.is_on(0)));
+            }
+            fputc('\n', stderr);
+        }
+    }
+}
+
+// CHOWDREN_BACKGROUND=<frame>:<tick>:<updates>: at that update push
+// SDL_APP_WILLENTERBACKGROUND and <updates> later SDL_APP_DIDENTERFOREGROUND,
+// as Android does when the app leaves and returns (platform.cpp's watch pauses
+// and resumes the audio device). A host check of the background pause.
+static void harness_background(int frame_index)
+{
+    static bool parsed = false;
+    static int frame = -1, tick = -1, updates = 0;
+    if (!parsed) {
+        parsed = true;
+        const char * b = getenv("CHOWDREN_BACKGROUND");
+        if (b && *b && sscanf(b, "%d:%d:%d", &frame, &tick, &updates) != 3)
+            frame = -1;
+    }
+    if (frame < 0 || frame_index != frame)
+        return;
+    SDL_Event e;
+    memset(&e, 0, sizeof(e));
+    if (h_tick == tick)
+        e.type = SDL_APP_WILLENTERBACKGROUND;
+    else if (h_tick == tick + updates)
+        e.type = SDL_APP_DIDENTERFOREGROUND;
+    else
+        return;
+    SDL_PushEvent(&e);
+    if (h_trace) fprintf(h_trace, "# app %s %d %d\n", e.type == SDL_APP_WILLENTERBACKGROUND ?
+                         "background" : "foreground", frame_index, h_tick);
+}
+
+void harness_before_events(int frame_index)
+{
+    if (h_active) h_audio_time += manager.dt;
+    if (h_active) harness_background(frame_index);
+    if (!h_active) {
+        if (!h_play) return;
+        // The platform has already delivered the real click to the mouse;
+        // mirror it into Multiple Touch slot 0 without re-sending it.
+        HarnessMultiTouch & m = harness_touch;
+        m.new_touch = m.end_touch = m.moved_touch = false;
+        bool down = manager.mouse.is_pressed(SDL_BUTTON_LEFT);
+        float x = float(manager.mouse_x), y = float(manager.mouse_y);
+        if (down && !h_play_down) new_touch(0, x, y, false);
+        else if (!down && h_play_down) end_touch(0, false);
+        else if (down && !m.touches.empty() && !m.touches[0].free &&
+                 (m.touches[0].x != x || m.touches[0].y != y)) move_touch(0, x, y, false);
+        h_play_down = down;
+        return;
+    }
+    if (frame_index == h_dump_frame && h_tick == h_dump_tick) dump_instances(frame_index);
+    HarnessMultiTouch & m = harness_touch;
+    m.new_touch = m.end_touch = m.moved_touch = false;
+    // The platform re-reads the (absent) real mouse every update; on Android
+    // the first touch IS the mouse, so a held slot-0 touch re-asserts it.
+    if (!m.touches.empty() && !m.touches[0].free) {
+        manager.mouse_x = int(m.touches[0].x);
+        manager.mouse_y = int(m.touches[0].y);
+    }
+    // Frame indices are identities, not a timeline: startup can visit a
+    // high-numbered options frame before returning to the title. Each row
+    // fires once on its first matching frame visit that reaches its tick.
+    for (size_t i = 0; i < h_inputs.size(); i++) {
+        InputRow & r = h_inputs[i];
+        if (r.consumed || r.frame_index != frame_index || r.tick > h_tick) continue;
+        if (r.op == OP_DOWN_OBJECT) {
+            float x, y;
+            if (!object_center(r.object, &x, &y)) {
+                fprintf(stderr, "harness: frame %d tick %d: no live instance named '%s'\n", frame_index, h_tick, r.object.c_str());
+                if (h_trace) fprintf(h_trace, "# miss %d %d %s\n", frame_index, h_tick, r.object.c_str());
+            } else {
+                new_touch(r.pointer, x, y);
+                if (h_trace) fprintf(h_trace, "# touch %d %d %s %.0f %.0f\n", frame_index, h_tick, r.object.c_str(), x, y);
+            }
+        } else if (r.op == OP_DOWN) new_touch(r.pointer, r.x, r.y);
+        else if (r.op == OP_MOVE) move_touch(r.pointer, r.x, r.y);
+        else end_touch(r.pointer);
+        r.consumed = true;
+    }
+}
+
+// CHOWDREN_WATCH=name:i,j,...: after each update, one '# watch' trace line with
+// the first live instance's x and the listed alterable values.
+static void watch_line(int frame_index)
+{
+    static bool parsed = false;
+    static std::string name;
+    static std::vector<int> idx;
+    if (!parsed) {
+        parsed = true;
+        const char * w = getenv("CHOWDREN_WATCH");
+        if (w && *w) {
+            std::string spec(w);
+            size_t colon = spec.rfind(':');
+            name = spec.substr(0, colon);
+            for (const char * c = spec.c_str() + colon + 1; c && *c; ) {
+                idx.push_back(atoi(c));
+                c = strchr(c, ',');
+                if (c) c++;
+            }
+        }
+    }
+    if (name.empty() || !h_trace) return;
+    Frame * f = manager.frame;
+    for (size_t li = 0; li < f->layers.size(); li++) {
+        Layer & layer = f->layers[li];
+        for (LayerInstances::iterator it = layer.instances.begin(); it != layer.instances.end(); ++it) {
+            FrameObject & obj = *it;
+            if (obj.get_name() != name) continue;
+            fprintf(h_trace, "# watch %d %d off %d %d new %d x %d", frame_index, h_tick, f->off_x, f->off_y,
+                    f->new_off_x, obj.get_x());
+            for (size_t i = 0; i < idx.size(); i++)
+                fprintf(h_trace, " v%d %g", idx[i], obj.alterables ? double(obj.alterables->values.get(idx[i])) : 0.0);
+            fputc('\n', h_trace);
+            return;
+        }
+    }
+}
+
+// The object type ids built as a Counter. Counter's constructor notes each one
+// (objects/counter.cpp), the default counter during static initialisation, so
+// this is a zero-initialised array rather than a container. RTTI is off, and a
+// name alone does not say that an instance is a Counter.
+static unsigned char h_counter_types[65536];
+
+void harness_note_counter_type(int type_id)
+{
+    if (type_id >= 0 && type_id < int(sizeof h_counter_types)) h_counter_types[type_id] = 1;
+}
+
+// CHOWDREN_WATCH_COUNTER=name,name,...: after each update, one '# counter' trace
+// line, `# counter <frame> <tick>` and then, in the order named, the value of
+// each named Counter's first live instance, or '-' when this frame has none.
+// Names may hold spaces, not commas; the spec is written once as '# counters'.
+static void counter_line(int frame_index)
+{
+    static bool parsed = false;
+    static std::vector<std::string> names;
+    if (!parsed) {
+        parsed = true;
+        const char * w = getenv("CHOWDREN_WATCH_COUNTER");
+        for (const char * c = w; c && *c; ) {
+            const char * end = strchr(c, ',');
+            names.push_back(end ? std::string(c, end - c) : std::string(c));
+            c = end ? end + 1 : NULL;
+        }
+        if (!names.empty() && h_trace) fprintf(h_trace, "# counters %s\n", w);
+    }
+    if (names.empty() || !h_trace) return;
+    fprintf(h_trace, "# counter %d %d", frame_index, h_tick);
+    Frame * f = manager.frame;
+    for (size_t n = 0; n < names.size(); n++) {
+        Counter * found = NULL;
+        for (size_t li = 0; li < f->layers.size() && found == NULL; li++) {
+            Layer & layer = f->layers[li];
+            for (LayerInstances::iterator it = layer.instances.begin(); it != layer.instances.end(); ++it) {
+                FrameObject & obj = *it;
+                if (obj.flags & DESTROYING) continue;
+                if (obj.id < 0 || obj.id >= int(sizeof h_counter_types) || !h_counter_types[obj.id]) continue;
+                if (obj.get_name() != names[n]) continue;
+                found = (Counter *)&obj;
+                break;
+            }
+        }
+        if (found) fprintf(h_trace, " %.17g", found->value);
+        else fputs(" -", h_trace);
+    }
+    fputc('\n', h_trace);
+}
+
+// The first live instance named `name` in the current frame, or NULL.
+static FrameObject * first_named(const std::string & name)
+{
+    Frame * f = manager.frame;
+    for (size_t li = 0; li < f->layers.size(); li++) {
+        Layer & layer = f->layers[li];
+        for (LayerInstances::iterator it = layer.instances.begin(); it != layer.instances.end(); ++it) {
+            FrameObject & obj = *it;
+            if (obj.flags & DESTROYING) continue;
+            if (obj.get_name() == name) return &obj;
+        }
+    }
+    return NULL;
+}
+
+// CHOWDREN_WATCH_OVERLAP=<zone>:<name>,<name>,...: after each update, one
+// '# overlap <frame> <tick>' trace line and then, in the order named, 1 when
+// that object's first live instance overlaps the zone object's first live
+// instance, 0 when it does not, '-' when either is absent from the frame or has
+// no collision. The test is FrameObject::overlaps, the one IsOverlapping
+// compiles to. Names may hold spaces, not commas or colons; the spec is written
+// once as '# overlaps'. Nothing else reads the result.
+static void overlap_line(int frame_index)
+{
+    static bool parsed = false;
+    static std::string zone;
+    static std::vector<std::string> names;
+    if (!parsed) {
+        parsed = true;
+        const char * w = getenv("CHOWDREN_WATCH_OVERLAP");
+        if (w && *w) {
+            std::string spec(w);
+            size_t colon = spec.find(':');
+            if (colon == std::string::npos) {
+                fprintf(stderr, "harness: CHOWDREN_WATCH_OVERLAP is <zone>:<name>,...\n");
+                exit(3);
+            }
+            zone = spec.substr(0, colon);
+            for (const char * c = spec.c_str() + colon + 1; c && *c; ) {
+                const char * end = strchr(c, ',');
+                names.push_back(end ? std::string(c, end - c) : std::string(c));
+                c = end ? end + 1 : NULL;
+            }
+            if (h_trace) fprintf(h_trace, "# overlaps %s\n", w);
+        }
+    }
+    if (names.empty() || !h_trace) return;
+    fprintf(h_trace, "# overlap %d %d", frame_index, h_tick);
+    FrameObject * z = first_named(zone);
+    for (size_t n = 0; n < names.size(); n++) {
+        FrameObject * o = first_named(names[n]);
+        if (z == NULL || o == NULL || z->collision == NULL || o->collision == NULL) fputs(" -", h_trace);
+        else fputs(o->overlaps(z) ? " 1" : " 0", h_trace);
+    }
+    fputc('\n', h_trace);
+}
+
+bool harness_after_events(int frame_index)
+{
+    if (!h_active) return true;
+    watch_line(frame_index);
+    counter_line(frame_index);
+    overlap_line(frame_index);
+    if (h_trace) {
+        fprintf(h_trace, "%d %d %u %u", frame_index, h_tick, fusion_draws, fusion_graine);
+        GlobalValues * g = manager.values;
+        if (g) for (size_t i = 0; i < g->values.size(); i++) fprintf(h_trace, " %g", double(g->values[i]));
+        fputc('\n', h_trace);
+    }
+    h_tick++;
+    h_total_ticks++;
+    if (h_stop_frame >= 0 && frame_index == h_stop_frame && h_max_ticks >= 0 && h_tick >= h_max_ticks) {
+        if (h_trace) { fprintf(h_trace, "# stop target frame %d ticks %d total %d\n", frame_index, h_tick, h_total_ticks); fflush(h_trace); }
+        if (h_draw_wall >= 0.0)
+            fprintf(stderr, "harness: stopped at frame %d tick %d wall %.3f, drawn for %.3f s\n", frame_index, h_tick,
+                    wall_now(), wall_now() - h_draw_wall);
+        return false;
+    }
+    if (h_total_ticks >= h_max_total_ticks) {
+        fprintf(stderr, "harness: total tick limit %d reached at frame %d tick %d\n", h_total_ticks, frame_index, h_tick);
+        if (h_trace) { fprintf(h_trace, "# stop total ticks %d frame %d tick %d\n", h_total_ticks, frame_index, h_tick); fflush(h_trace); }
+        return false;
+    }
+    return true;
+}
+
+extern "C" void glReadPixels(int, int, int, int, unsigned int, unsigned int, void *);
+extern "C" void glPixelStorei(unsigned int, int);
+
+void harness_after_draw(int width, int height)
+{
+    if (h_active && h_raw != NULL && (h_raw_draws++ % h_raw_every) == 0) {
+        static std::vector<unsigned char> raw;
+        raw.resize(size_t(WINDOW_WIDTH) * WINDOW_HEIGHT * 3);
+        glPixelStorei(0x0D05, 1);                                          // GL_PACK_ALIGNMENT
+        glReadPixels(0, 0, WINDOW_WIDTH, WINDOW_HEIGHT, 0x1907, 0x1401, &raw[0]);   // GL_RGB, GL_UNSIGNED_BYTE
+        if (fwrite(&raw[0], 1, raw.size(), h_raw) != raw.size()) {
+            fprintf(stderr, "harness: raw video write failed; stopping the stream\n");
+            fclose(h_raw);
+            h_raw = NULL;
+        }
+    }
+    if (!h_active || h_snaps.empty() || width <= 0 || height <= 0) return;
+    // h_tick already counts the update just drawn.
+    std::pair<int, int> here(h_frame_index, h_tick - 1);
+    bool wanted = false;
+    for (size_t i = 0; i < h_snaps.size(); i++) if (h_snaps[i] == here) wanted = true;
+    if (!wanted) return;
+    std::vector<unsigned char> px(size_t(width) * height * 3);
+    glPixelStorei(0x0D05, 1);                                  // GL_PACK_ALIGNMENT
+    glReadPixels(0, 0, width, height, 0x1907, 0x1401, &px[0]); // GL_RGB, GL_UNSIGNED_BYTE
+    const char * dir = getenv("CHOWDREN_SNAP_DIR");
+    char path[512];
+    snprintf(path, sizeof(path), "%s/frame%d-tick%d.ppm", dir && *dir ? dir : ".", here.first, here.second);
+    FILE * f = fopen(path, "wb");
+    if (!f) { fprintf(stderr, "harness: cannot write %s\n", path); return; }
+    fprintf(f, "P6\n%d %d\n255\n", width, height);
+    for (int y = height - 1; y >= 0; y--) fwrite(&px[size_t(y) * width * 3], 1, size_t(width) * 3, f);
+    fclose(f);
+    fprintf(stderr, "harness: wrote %s\n", path);
+}
