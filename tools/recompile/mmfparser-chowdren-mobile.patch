+// Chowdren opens "./Assets.dat" with fopen (stdiofile.cpp), which cannot see a
+// file packed inside the APK. Copy it out of assets/ to internal storage, then
+// chdir there so every later fopen resolves. image_cache/ is not shipped in the
+// APK; the runtime rebuilds what it needs from Assets.dat.
+//
+// The APK's copy is read through AAssetManager, not SDL_RWFromFile: on Android
+// SDL opens a relative path from internal storage first, so it measured the
+// extracted copy against itself and never extracted an updated APK's
+// Assets.dat. The phone then ran new code over the first install's sound table
+// (menu blips played the jumpscare, 2026-09-27). The copy is now keyed by a
+// stamp -- the installed APK's size and mtime and the asset's length -- and is
+// replaced whole (written to Assets.dat.part, then renamed) when that changes.
+static AAssetManager * apk_asset_manager(std::string * apk_path)
+{
+    JNIEnv * env = (JNIEnv *)SDL_AndroidGetJNIEnv();
+    jobject activity = (jobject)SDL_AndroidGetActivity();
+    if (env == NULL || activity == NULL)
+        return NULL;
+    jclass cls = env->GetObjectClass(activity);
+    jmethodID get_assets = env->GetMethodID(cls, "getAssets",
+        "()Landroid/content/res/AssetManager;");
+    jmethodID get_path = env->GetMethodID(cls, "getPackageCodePath",
+        "()Ljava/lang/String;");
+    jobject assets = env->CallObjectMethod(activity, get_assets);
+    jstring path = (jstring)env->CallObjectMethod(activity, get_path);
+    if (path != NULL) {
+        const char * chars = env->GetStringUTFChars(path, NULL);
+        *apk_path = chars;
+        env->ReleaseStringUTFChars(path, chars);
+        env->DeleteLocalRef(path);
+    }
+    // a global reference keeps the manager valid for the process
+    static jobject global_assets = NULL;
+    AAssetManager * mgr = NULL;
+    if (assets != NULL) {
+        if (global_assets == NULL)
+            global_assets = env->NewGlobalRef(assets);
+        mgr = AAssetManager_fromJava(env, global_assets);
+        env->DeleteLocalRef(assets);
+    }
+    env->DeleteLocalRef(cls);
+    env->DeleteLocalRef(activity);
+    return mgr;
+}
+
+static void set_resources_dir()
+{
+    const char * base = SDL_AndroidGetInternalStoragePath();
+    if (base == NULL) {
+        std::cout << "No Android internal storage path" << std::endl;
+        return;
+    }
+    if (chdir(base) != 0) {
+        std::cout << "chdir(" << base << ") failed" << std::endl;
+        return;
+    }
+
+    std::string apk_path;
+    AAssetManager * mgr = apk_asset_manager(&apk_path);
+    if (mgr == NULL) {
+        std::cout << "No AAssetManager for the APK's assets" << std::endl;
+        return;
+    }
+    AAsset * src = AAssetManager_open(mgr, "Assets.dat", AASSET_MODE_STREAMING);
+    if (src == NULL) {
+        std::cout << "Assets.dat not found in APK" << std::endl;
+        return;
+    }
+    long long want = (long long)AAsset_getLength64(src);
+    long long apk_size = -1, apk_mtime = -1;
+    struct stat apk;
+    if (!apk_path.empty() && stat(apk_path.c_str(), &apk) == 0) {
+        apk_size = (long long)apk.st_size;
+        apk_mtime = (long long)apk.st_mtime;
+    }
+    char stamp[128];
+    snprintf(stamp, sizeof(stamp), "%lld %lld %lld", apk_size, apk_mtime, want);
+    char old[128] = "";
+    FILE * sf = fopen("Assets.dat.stamp", "r");
+    if (sf != NULL) {
+        if (fgets(old, sizeof(old), sf) == NULL)
+            old[0] = 0;
+        fclose(sf);
+    }
+    struct stat st;
+    if (strcmp(old, stamp) == 0 && stat("Assets.dat", &st) == 0 &&
+        (long long)st.st_size == want) {
+        AAsset_close(src);
+        std::cout << "Assets.dat is current (stamp " << stamp << ")" << std::endl;
+        return;
+    }
+
+    std::cout << "Extracting Assets.dat (" << want << " bytes; stamp '" << stamp
+              << "', was '" << old << "')" << std::endl;
+    FILE * dst = fopen("Assets.dat.part", "wb");
+    if (dst == NULL) {
+        std::cout << "Could not open Assets.dat.part for writing" << std::endl;
+        AAsset_close(src);
+        return;
+    }
+    char buf[1 << 16];
+    long long written = 0;
+    int n;
+    while ((n = AAsset_read(src, buf, sizeof(buf))) > 0)
+        written += (long long)fwrite(buf, 1, n, dst);
+    fclose(dst);
+    AAsset_close(src);
+    if (written != want || rename("Assets.dat.part", "Assets.dat") != 0) {
+        std::cout << "Assets.dat extraction failed (" << written << " of " << want
+                  << " bytes)" << std::endl;
+        remove("Assets.dat.part");
+        return;
+    }
+    sf = fopen("Assets.dat.stamp", "w");
+    if (sf != NULL) {
+        fputs(stamp, sf);
+        fclose(sf);
+    }
+}
