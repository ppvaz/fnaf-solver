+#ifndef CHOWDREN_ANDROID_AUDIO_ROUTE_H
+#define CHOWDREN_ANDROID_AUDIO_ROUTE_H
+
+// The rebuild's audio route on Android (personal research builds). openal-soft
+// plays the whole mix through one OpenSL ES player; its performance mode picks
+// the output. OpenSL ES's default can give a FAST track, the path retail
+// SoundPool effects take on the Moto g56, which the platform's
+// AudioPlaybackCapture does not mix (docs/device/ANDROID-AUDIO-CAPTURE.md).
+// Two system properties, read once when audio opens, choose the mode without a
+// rebuild (adb shell setprop <name> <value>, then restart the app):
+//
+//   debug.rebuild.audio_capture   1, on or true: power-saving, a deep-buffer
+//                                  track that AudioPlaybackCapture can mix.
+//                                  Unset, empty or anything else: OFF.
+//   debug.rebuild.audio_perf      none, latency, latency-effects or
+//                                  power-saving: that mode, whatever the switch
+//                                  says. Any other value is ignored.
+//
+// OFF (both unset) requests nothing, so the retail-like default routing holds.
+// The chosen mode reaches openal-soft's OpenSL backend as
+// ALSOFT_OPENSL_PERFORMANCE_MODE (tools/recompile/android/
+// openal-soft-1.23.1-opensl-performance-mode.patch), which logs the mode it
+// requested and the mode OpenSL granted under the tag "openal".
+
+#include <string.h>
+
+// NULL means "request nothing" (OpenSL ES's default).
+inline const char * rebuild_audio_perf_mode(const char * capture, const char * perf)
+{
+    static const char * const modes[] = {"none", "latency", "latency-effects", "power-saving"};
+    if (perf != NULL && *perf) {
+        for (unsigned i = 0; i < sizeof(modes) / sizeof(modes[0]); i++)
+            if (strcmp(perf, modes[i]) == 0)
+                return modes[i];
+    }
+    if (capture != NULL && (strcmp(capture, "1") == 0 || strcmp(capture, "on") == 0 ||
+                            strcmp(capture, "true") == 0))
+        return "power-saving";
+    return NULL;
+}
+
+#ifdef __ANDROID__
+#include <stdlib.h>
+#include <sys/system_properties.h>
+#include <android/log.h>
+
+inline void apply_rebuild_audio_route()
+{
+    char capture[PROP_VALUE_MAX] = "";
+    char perf[PROP_VALUE_MAX] = "";
+    __system_property_get("debug.rebuild.audio_capture", capture);
+    __system_property_get("debug.rebuild.audio_perf", perf);
+    const char * mode = rebuild_audio_perf_mode(capture, perf);
+    if (mode != NULL)
+        setenv("ALSOFT_OPENSL_PERFORMANCE_MODE", mode, 1);
+    else
+        unsetenv("ALSOFT_OPENSL_PERFORMANCE_MODE");
+    __android_log_print(ANDROID_LOG_INFO, "chowdren",
+        "audio route: debug.rebuild.audio_capture='%s' debug.rebuild.audio_perf='%s' -> "
+        "OpenSL performance mode %s", capture, perf, mode != NULL ? mode : "default (not set)");
+}
+#endif
+
+#endif // CHOWDREN_ANDROID_AUDIO_ROUTE_H
