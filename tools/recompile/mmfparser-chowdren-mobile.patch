+// GL ES 1.1 stand-in for desktop/glslshader.cpp.
+//
+// FNaF 2's generated project compiles no shaders (glslshader.cpp is excluded on
+// this target), and the Chowdren Render:: layer draws through fixed-function
+// client arrays which ES 1.1 provides natively.  So every BaseShader entry
+// point here is a no-op — the fixed pipeline does modulate texturing by
+// default — and the only part of shadercommon.cpp that still matters is the
+// blend-func / blend-equation switching, which is GL-version-agnostic once the
+// *OES entry points are remapped in include_gl.h.
+//
+// Consequence: the ink-effect shaders (blur, monochrome, tint, ...) render as
+// plain textures.  The base game — sprites, backdrops, text, additive/subtract
+// blends — renders correctly.
+
+#include "include_gl.h"
+#include "glslshader.h"
+#include "shadercommon.h"
+#include "frameobject.h"
+#include "fileio.h"
+#include "render.h"
+
+BaseShader * BaseShader::current = NULL;
+
+BaseShader::BaseShader(unsigned int id, int flags,
+                       const char * texture_parameter)
+: initialized(false), id(id), flags(flags),
+  texture_parameter(texture_parameter)
+{
+}
+
+void BaseShader::initialize() {}
+void BaseShader::initialize_parameters() {}
