+// SDL 2.30 no longer mirrors stdout/stderr to logcat; do it here so the engine's
+// std::cout diagnostics are visible during Android bring-up.
+static void * stdio_to_logcat(void * arg)
+{
+    int fd = (int)(intptr_t)arg;
+    char line[512];
+    size_t n = 0;
+    char c;
+    while (read(fd, &c, 1) == 1) {
+        if (c == '\n' || n == sizeof(line) - 1) {
+            line[n] = 0;
+            __android_log_write(ANDROID_LOG_INFO, "Chowdren", line);
+            n = 0;
+        } else {
+            line[n++] = c;
+        }
+    }
+    return NULL;
+}
