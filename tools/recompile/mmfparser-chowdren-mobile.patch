diff --git a/Chowdren/chowdren/writers/extensions/Kyso.py b/Chowdren/chowdren/writers/extensions/Kyso.py
new file mode 100644
index 0000000..2674d93
--- /dev/null
+++ b/Chowdren/chowdren/writers/extensions/Kyso.py
@@ -0,0 +1,71 @@
+from chowdren.writers.objects import ObjectWriter
+
+from chowdren.writers.events import (ActionMethodWriter,
+    ConditionMethodWriter, ExpressionMethodWriter, make_table)
+
+# Extensions.CRunKyso (build-296 Android runtime): a flipbook of image handles.
+# createRunObject reads swidth, sheight (short), mode, flags (int), 4 skipped
+# bytes, play_speed (int), then for version 2 BackToFrame and one unused short,
+# then AnimQty and AnimQty image handles (short).
+
+class Kyso(ObjectWriter):
+    class_name = 'KysoObject'
+    filename = 'kyso'
+    update = True
+
+    def initialize(self):
+        data = self.get_data()
+        self.width = data.readShort()
+        self.height = data.readShort()
+        self.mode = data.readInt()
+        self.flags = data.readInt()
+        data.skipBytes(4)
+        self.play_speed = data.readInt()
+        self.back_to_frame = 0
+        if self.common.extensionVersion == 2:
+            self.back_to_frame = data.readShort()
+            data.readShort()
+        count = data.readShort()
+        self.images = [data.readShort() for _ in xrange(count)]
+
+    def write_init(self, writer):
+        writer.putlnc('width = %s;', self.width)
+        writer.putlnc('height = %s;', self.height)
+        if self.images:
+            writer.putlnc('static Image * static_images[%s];',
+                          len(self.images))
+            for index, image in enumerate(self.images):
+                writer.putlnc('static_images[%s] = %s;', index,
+                              self.converter.get_image(image))
+            images = 'static_images'
+        else:
+            images = 'NULL'
+        writer.putlnc('init_kyso(%s, %s, %s, %s, %s, %s);', images,
+                      len(self.images), self.mode, self.flags,
+                      self.play_speed, self.back_to_frame)
+
+    def get_images(self):
+        return self.images
+
+actions = make_table(ActionMethodWriter, {
+    0 : 'load_mode',
+    1 : 'play',
+    2 : 'play_loop',
+    3 : 'reset',
+    4 : 'set_speed',
+    5 : 'load_custom',
+    10 : 'set_back_to_frame'
+})
+
+conditions = make_table(ConditionMethodWriter, {
+    3 : 'is_anim',
+    4 : 'is_playing'
+})
+
+expressions = make_table(ExpressionMethodWriter, {
+    1 : '.anim_qty',
+    2 : '.anim_frame'
+})
+
+def get_object():
+    return Kyso
