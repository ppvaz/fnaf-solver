+// Fusion's division of int values: the converter emits `/FusionDiv()/` when
+// the left operand carries no double literal. The rebuild stores alterable,
+// counter and global values as doubles; an integral one divided by an int
+// divides as integers, truncating as Java does. A double divisor divides as
+// doubles. Division by zero gives 0, as MathHelper's does.
+struct FusionDiv {};
+
+template <class T>
+struct FusionDivValue
+{
+    T value;
+    FusionDivValue(T value) : value(value) {}
+};
+
+template <class T>
+inline FusionDivValue<T> operator/(T lhs, FusionDiv rhs)
+{
+    return FusionDivValue<T>(lhs);
+}
+
+template <class T>
+inline double operator/(FusionDivValue<T> lhs, int rhs)
+{
+    if (rhs == 0)
+        return 0;
+    double v = (double)lhs.value;
+    if (v == floor(v) && v > -2147483648.0 && v < 2147483648.0)
+        return (double)((int)v / rhs);
+    return v / rhs;
+}
+
+template <class T>
+inline double operator/(FusionDivValue<T> lhs, double rhs)
+{
+    if (rhs == 0.0)
+        return 0;
+    return (double)lhs.value / rhs;
+}
+
+template <class T>
+inline double operator/(FusionDivValue<T> lhs, float rhs)
+{
+    if (rhs == 0.0f)
