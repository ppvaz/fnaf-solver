+def mp3_to_wav(data, name):
+    # ffmpeg on the conversion host: 16-bit PCM WAV at the source's rate and
+    # channel count. No MP3 decoder is bundled with the runtime.
+    import subprocess
+    import tempfile
+    src = tempfile.NamedTemporaryFile(suffix='.mp3', delete=False)
+    dst = src.name[:-4] + '.wav'
+    try:
+        src.write(str(data))
+        src.close()
+        # A seekable output, so the RIFF and data sizes are written.
+        ret = subprocess.call(['ffmpeg', '-v', 'error', '-nostdin', '-y', '-i',
+                               src.name, '-map_metadata', '-1', '-f', 'wav',
+                               '-acodec', 'pcm_s16le', '-bitexact', dst])
+        out = open(dst, 'rb').read() if ret == 0 and os.path.exists(dst) else ''
+        if out[:4] != 'RIFF':
+            raise RuntimeError('ffmpeg could not decode MP3 sound %r' % name)
+    finally:
+        os.unlink(src.name)
+        if os.path.exists(dst):
+            os.unlink(dst)
+    print 'sound %r: MP3 decoded to WAV (%d bytes)' % (name, len(out))
+    return out
