@@ -0,0 +1,54 @@
+#ifndef CHOWDREN_KYSO_H
+#define CHOWDREN_KYSO_H
+
+#include "frameobject.h"
+#include "image.h"
+
+// Extensions.CRunKyso of the build-296 Android runtime: a flipbook of image
+// handles advanced by play_speed percent per loop. FNaF 2 draws its
+// jumpscares with it (LoadCustom, Play, PlayLoop).
+class KysoObject : public FrameObject
+{
+public:
+    FRAMEOBJECT_HEAD(KysoObject)
+
+    Image ** images;
+    int anim_qty;
+    Image * image;
+    int mode;
+    int load_frame;
+    int load_n_custom;
+    unsigned int loop_count;
+    int anim_counter;
+    int anim_in_frame;
+    int anim_frame;
+    int anim_repeat;
+    int back_to_frame;
+    int play_speed;
+    bool anim_loop;
+    bool playing;
+    bool show_first_frame;
+
+    KysoObject(int x, int y, int type_id);
+    ~KysoObject();
+    void init_kyso(Image ** images, int count, int mode, int flags,
+                   int play_speed, int back_to_frame);
