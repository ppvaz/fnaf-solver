@@ -0,0 +1,31 @@
+#ifndef CHOWDREN_TIMER_EVENTS_H
+#define CHOWDREN_TIMER_EVENTS_H
+#include <list>
+
+// ACT_EVENTAFTER: append a one-shot at rhTimer + delay (integer milliseconds).
+// handle_TimerEvents walks insertion order, including newly appended entries,
+// before the ordinary event list. Repeat timers are not implemented here.
+class TimerEvents
+{
+    struct Entry {
+        long long deadline;
+        int callback;
+        Entry(long long when, int id) : deadline(when), callback(id) {}
+    };
+    std::list<Entry> entries;
+public:
+    void clear() { entries.clear(); }
+    void schedule(long long now, int delay, int callback)
+    { entries.push_back(Entry(now + delay, callback)); }
+
+    template <class Owner> void dispatch(long long now, Owner * owner)
+    {
+        std::list<Entry>::iterator it = entries.begin();
+        while (it != entries.end()) {
+            if (now < it->deadline) { ++it; continue; }
+            owner->event_callback(it->callback);
+            it = entries.erase(it);
+        }
+    }
+};
+#endif
