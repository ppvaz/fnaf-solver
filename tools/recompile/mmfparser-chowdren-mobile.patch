+def left_operand(text):
+    """The C++ text of the operand that ends `text`: back to the enclosing
+    '(' or the last top-level + - * / % , (skipping '->')."""
+    depth = 0
+    i = len(text) - 1
+    while i >= 0:
+        c = text[i]
+        if c == ')':
+            depth += 1
+        elif c == '(':
+            if depth == 0:
+                break
+            depth -= 1
+        elif depth == 0:
+            if c == '>' and i > 0 and text[i - 1] == '-':
+                i -= 2
+                continue
+            if c in '+-*/%,':
+                break
+        i -= 1
+    return text[i + 1:]
