{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tools/**/*.ts"],
  "files": ["packages/kernel/src/types.ts", "packages/kernel/src/contracts/types.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "packages/play/test/**/*.ts", "packages/propose/test/**/*.ts", "packages/review/test/**/*.ts", "packages/source/test/**/*.ts", "apps/desktop/test/**/*.ts", "apps/trainer/test/**/*.ts", "packages/propose/parked/**/*.ts", "tools/ts-migrate.ts"]
}
