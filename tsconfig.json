{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"],
  "files": ["packages/kernel/src/types.ts", "packages/kernel/src/contracts/types.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "packages/kernel/src/**/*.ts", "packages/source/src/**/*.ts", "packages/play/src/**/*.ts", "packages/propose/src/**/*.ts", "packages/review/src/**/*.ts", "apps/desktop/src/**/*.ts", "apps/trainer/src/**/*.ts", "apps/wiki/**/*.ts"]
}
