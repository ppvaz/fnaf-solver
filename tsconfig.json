{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"],
  "files": ["packages/kernel/src/types.ts", "packages/kernel/src/contracts/types.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "packages/play/test/**/*.ts", "packages/propose/test/**/*.ts", "packages/review/test/**/*.ts", "packages/source/test/**/*.ts", "packages/propose/bin/**/*.ts", "packages/review/bin/**/*.ts", "packages/review/venue-grid/**/*.ts", "apps/desktop/test/**/*.ts", "apps/lab/test/**/*.ts", "apps/trainer/test/**/*.ts", "apps/desktop/bin/**/*.ts", "packages/source/decompile/**/*.ts", "packages/source/recompile/**/*.ts", "packages/propose/parked/**/*.ts", "packages/propose/bindings/**/*.ts"]
}
